{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Pure Dart Server",
      "type": "shell",
      "command": "dart run bin/server.dart",
      "options": {
        "cwd": "${workspaceFolder}/packages/game_server"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Flutter Desktop (macOS)",
      "type": "shell",
      "command": "flutter run -d macos",
      "options": {
        "cwd": "${workspaceFolder}/apps/flutter_app"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Flutter Web (Chrome)",
      "type": "shell",
      "command": "flutter run -d chrome",
      "options": {
        "cwd": "${workspaceFolder}/apps/flutter_app"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Flutter Tests",
      "type": "shell",
      "command": "flutter test",
      "options": {
        "cwd": "${workspaceFolder}/apps/flutter_app"
      },
      "problemMatcher": []
    }
  ]
}
